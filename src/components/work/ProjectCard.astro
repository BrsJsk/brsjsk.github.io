---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

const categoryLabel: Record<string, string> = {
	website: 'Website',
	'web-app': 'Web app',
	'mobile-app': 'Mobile app',
};
---

<a href={`/work/${project.id}`} class="project-card__link" data-project-card={project.data.category}>
	<Card hover={false} class="project-card">
		<div class="project-card__cover">
			<Image src={project.data.cover} alt={project.data.title} width={720} height={450} />
		</div>
		<div class="project-card__body">
			<p class="project-card__meta">
				{[categoryLabel[project.data.category], project.data.year].filter(Boolean).join(' · ')}
			</p>
			<h3 class="project-card__title">{project.data.title}</h3>
			{project.data.summary && <p class="project-card__summary">{project.data.summary}</p>}
			{project.data.stack.length > 0 && <p class="project-card__stack">{project.data.stack.join(' · ')}</p>}
		</div>
	</Card>
</a>

<style>
	.project-card__link {
		display: block;
		text-decoration: none;
	}

	.project-card__cover {
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.project-card__cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease-out;
	}

	.project-card__link:hover .project-card__cover :global(img) {
		transform: scale(1.02);
	}

	.project-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.project-card__meta {
		font-size: 0.8125rem;
		color: var(--color-text-subtle);
	}

	.project-card__title {
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.project-card__summary {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.project-card__stack {
		font-size: 0.8125rem;
		color: var(--color-text-subtle);
		margin-top: 0.25rem;
	}
</style>
