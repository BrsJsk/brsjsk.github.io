---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	images: ImageMetadata[];
	alt: string;
}

const { images, alt } = Astro.props;
---

<div class="project-gallery" data-project-gallery>
	<div class="project-gallery__track" data-gallery-track>
		{
			images.map((image, i) => (
				<div class="project-gallery__slide" data-gallery-slide>
					<Image
						src={image}
						alt={images.length > 1 ? `${alt} — view ${i + 1}` : alt}
						width={1600}
						height={1000}
					/>
				</div>
			))
		}
	</div>

	{
		images.length > 1 && (
			<>
				<button
					type="button"
					class="project-gallery__nav project-gallery__nav--prev"
					data-gallery-prev
					aria-label="Previous image"
				>
					<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path
							d="M10 3L5 8L10 13"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</button>
				<button
					type="button"
					class="project-gallery__nav project-gallery__nav--next"
					data-gallery-next
					aria-label="Next image"
				>
					<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path
							d="M6 3L11 8L6 13"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</button>
				<div class="project-gallery__dots" data-gallery-dots>
					{images.map((_, i) => (
						<button
							type="button"
							class="project-gallery__dot"
							data-gallery-dot
							aria-label={`Go to image ${i + 1}`}
						/>
					))}
				</div>
			</>
		)
	}
</div>

<style>
	.project-gallery {
		position: relative;
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.project-gallery__track {
		display: flex;
		width: 100%;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
	}

	.project-gallery__track::-webkit-scrollbar {
		display: none;
	}

	.project-gallery__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
	}

	.project-gallery__slide :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.project-gallery__nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 9999px;
		border: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-surface) 80%, transparent);
		color: var(--color-text);
		cursor: pointer;
		backdrop-filter: blur(6px);
		transition:
			background-color 0.2s ease-out,
			border-color 0.2s ease-out;
	}

	.project-gallery__nav:hover {
		background: var(--color-elevated);
		border-color: var(--color-border-strong);
	}

	.project-gallery__nav svg {
		width: 1rem;
		height: 1rem;
	}

	.project-gallery__nav--prev {
		left: 1rem;
	}

	.project-gallery__nav--next {
		right: 1rem;
	}

	.project-gallery__dots {
		position: absolute;
		bottom: 1rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.5rem;
	}

	.project-gallery__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		border: none;
		padding: 0;
		background: color-mix(in srgb, white 45%, transparent);
		cursor: pointer;
		transition: background-color 0.2s ease-out;
	}

	.project-gallery__dot[data-active='true'] {
		background: white;
	}

	@media (max-width: 640px) {
		.project-gallery__nav {
			width: 2.25rem;
			height: 2.25rem;
		}
	}
</style>

<script>
	function initProjectGalleries() {
		document.querySelectorAll<HTMLElement>('[data-project-gallery]').forEach((gallery) => {
			const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
			const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
			const dots = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-dot]'));
			const prevBtn = gallery.querySelector<HTMLElement>('[data-gallery-prev]');
			const nextBtn = gallery.querySelector<HTMLElement>('[data-gallery-next]');
			if (!track || slides.length === 0 || gallery.dataset.galleryInit) return;
			gallery.dataset.galleryInit = 'true';

			const setActive = (index: number) => {
				dots.forEach((dot, i) => dot.setAttribute('data-active', String(i === index)));
			};

			const goTo = (index: number) => {
				const clamped = (index + slides.length) % slides.length;
				slides[clamped].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
			};

			const currentIndex = () => {
				const trackLeft = track.scrollLeft;
				let closest = 0;
				let closestDistance = Infinity;
				slides.forEach((slide, i) => {
					const distance = Math.abs(slide.offsetLeft - track.offsetLeft - trackLeft);
					if (distance < closestDistance) {
						closestDistance = distance;
						closest = i;
					}
				});
				return closest;
			};

			prevBtn?.addEventListener('click', () => goTo(currentIndex() - 1));
			nextBtn?.addEventListener('click', () => goTo(currentIndex() + 1));
			dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

			let scrollTimeout: ReturnType<typeof setTimeout>;
			track.addEventListener('scroll', () => {
				clearTimeout(scrollTimeout);
				scrollTimeout = setTimeout(() => setActive(currentIndex()), 80);
			});

			setActive(0);
		});
	}

	initProjectGalleries();
</script>
