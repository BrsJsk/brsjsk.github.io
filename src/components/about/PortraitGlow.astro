---
import { Image } from 'astro:assets';
import GradientMesh from '../ui/GradientMesh.astro';
import { OWNER_NAME } from '../../consts';
import portrait from '../../assets/boris.jpg';
---

<div class="portrait">
	<GradientMesh variant="glow" opacity={0.3} />
	<div class="portrait__frame">
		<Image
			src={portrait}
			alt={OWNER_NAME}
			widths={[400, 600, 900]}
			sizes="(min-width: 1024px) 460px, 320px"
			loading="lazy"
			decoding="async"
			class="portrait__image"
		/>
	</div>
</div>

<style>
	.portrait {
		position: relative;
		display: flex;
		justify-content: center;
	}

	/* The real photo is a 3:2 landscape shot, so this is a framed image rather
	   than the background-removed cutout the section was first built around —
	   no bottom mask, no colour grading, shown as shot. */
	.portrait__frame {
		position: relative;
		z-index: 1;
		width: 100%;
		border-radius: var(--radius-xl);
		border: 1px solid var(--color-border);
		overflow: hidden;
	}

	.portrait__image {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (prefers-reduced-motion: no-preference) {
		.portrait :global(.mesh) {
			animation: portrait-float 24s ease-in-out infinite alternate;
		}
	}
</style>
