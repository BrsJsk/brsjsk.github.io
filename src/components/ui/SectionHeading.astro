---
interface Props {
	title: string;
	lead?: string;
	align?: 'left' | 'center';
	class?: string;
}

const { title, lead, align = 'left', class: className } = Astro.props;
---

<div
	class:list={[
		'flex flex-col gap-4',
		align === 'center' ? 'items-center text-center' : 'items-start text-left',
		className,
	]}
	data-reveal
>
	<h2
		class="text-[clamp(2.25rem,4.6vw,3.5rem)] font-bold leading-[1.02] tracking-[-0.038em] text-[var(--color-text)]"
	>
		{title}
	</h2>
	{
		lead && (
			<p
				class:list={[
					'text-[clamp(1rem,1.4vw,1.1875rem)] leading-[1.6] text-[var(--color-text-muted)]',
					align === 'center' ? 'max-w-[48ch]' : 'max-w-[65ch]',
				]}
			>
				{lead}
			</p>
		)
	}
</div>
