---
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n';
import { getPublishedPosts, readingTime, formatDate } from '../../lib/blog';
import Reveal from '../motion/Reveal.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';

const t = useTranslations();
const posts = (await getPublishedPosts()).slice(0, 2);
---

{
	posts.length > 0 && (
		<section class="blog-teaser u-section">
			<div class="u-container">
				<div class="blog-teaser__header">
					<p class="blog-teaser__eyebrow">{t.blog.teaserTitle}</p>
					<Button href="/blog" variant="ghost" arrow>
						{t.blog.readBlog}
					</Button>
				</div>

				<Reveal stagger class="blog-teaser__grid">
					{posts.map((post) => (
						<a href={`/blog/${post.id}`} class="blog-teaser__link">
							<Card hover={false} class="blog-teaser__card">
								{post.data.cover && (
									<div class="blog-teaser__cover">
										<Image src={post.data.cover} alt={post.data.title} width={640} height={400} />
									</div>
								)}
								<div class="blog-teaser__body">
									<p class="blog-teaser__meta">
										{formatDate(post.data.pubDate)} · {readingTime(post.body ?? '')} min
									</p>
									<h3 class="blog-teaser__title">{post.data.title}</h3>
									<p class="blog-teaser__description">{post.data.description}</p>
								</div>
							</Card>
						</a>
					))}
				</Reveal>
			</div>
		</section>
	)
}

<style>
	.blog-teaser__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.blog-teaser__eyebrow {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.5rem, 3vw, 2rem);
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.blog-teaser__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin-top: 2.5rem;
	}

	.blog-teaser__link {
		display: block;
		text-decoration: none;
	}

	.blog-teaser__cover {
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.blog-teaser__cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease-out;
	}

	.blog-teaser__link:hover .blog-teaser__cover :global(img) {
		transform: scale(1.02);
	}

	.blog-teaser__body {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.blog-teaser__meta {
		font-size: 0.8125rem;
		color: var(--color-text-subtle);
	}

	.blog-teaser__title {
		font-size: 1.125rem;
		font-weight: 500;
		color: var(--color-text);
	}

	.blog-teaser__description {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	@media (max-width: 640px) {
		.blog-teaser__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
