---
import { useTranslations } from '../../i18n';
import Reveal from '../motion/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const t = useTranslations();
---

<section class="process u-section">
	<div class="u-container">
		<SectionHeading title={t.process.title} />

		<div class="process__track">
			<div class="process__line" aria-hidden="true"></div>
			<Reveal stagger class="process__grid">
				{
					t.process.steps.map((step, i) => (
						<div class="process__step">
							<span class="process__number">{String(i + 1).padStart(2, '0')}</span>
							<h3 class="process__title">{step.title}</h3>
							<p class="process__description">{step.description}</p>
						</div>
					))
				}
			</Reveal>
		</div>
	</div>
</section>

<style>
	.process__track {
		position: relative;
		margin-top: 3rem;
	}

	.process__line {
		position: absolute;
		top: 0.75rem;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--color-border);
	}

	.process__grid {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	.process__step {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.process__number {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		width: 1.5rem;
		height: 1.5rem;
		background: var(--color-base);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		color: var(--color-text-subtle);
	}

	.process__title {
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.process__description {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	@media (max-width: 768px) {
		.process__line {
			display: none;
		}
		.process__grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.process__step {
			padding-left: 1.25rem;
			border-left: 1px solid var(--color-border);
		}
		.process__number {
			background: transparent;
		}
	}
</style>
