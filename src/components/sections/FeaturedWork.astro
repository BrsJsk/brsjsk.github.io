---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n';
import Reveal from '../motion/Reveal.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import SectionPattern from '../ui/SectionPattern.astro';

const t = useTranslations();

const categoryLabel: Record<string, string> = {
	website: 'Website',
	'web-app': 'Web app',
	'mobile-app': 'Mobile app',
};

// In-house products get their own section (InHouse.astro), so they're excluded
// here to avoid showing the same project twice on the home page.
const featured = (await getCollection('projects', ({ data }) => data.featured && !data.inHouse))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);
---

<section class="featured-work u-section">
	<SectionPattern />
	<div class="u-container featured-work__inner">
		<Reveal class="featured-work__header">
			<SectionHeading title={t.work.title} />
			<Button href="/work" variant="ghost" arrow class="featured-work__see-all">{t.work.seeAll}</Button>
		</Reveal>

		<Reveal stagger class="featured-work__grid">
			{
				featured.map((project) => (
					<a href={`/work/${project.id}`} class="featured-work__link">
						<Card hover={false} class="featured-work__card">
							<div class="featured-work__cover">
								<Image src={project.data.cover} alt={project.data.title} width={640} height={400} />
							</div>
							<div class="featured-work__body">
								<p class="featured-work__meta">
									{[categoryLabel[project.data.category], project.data.year].filter(Boolean).join(' · ')}
								</p>
								<h3 class="featured-work__title">{project.data.title}</h3>
								{project.data.summary && <p class="featured-work__summary">{project.data.summary}</p>}
							</div>
						</Card>
					</a>
				))
			}
		</Reveal>
	</div>
</section>

<style>
	.featured-work {
		position: relative;
		overflow: hidden;
	}

	.featured-work__inner {
		position: relative;
		z-index: 1;
	}

	.featured-work__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	/* auto-fit rather than a fixed 3 columns — with only two client projects a
	   hard 3-column grid would leave a visible hole. */
	.featured-work__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		gap: 1.5rem;
		margin-top: 3rem;
	}

	.featured-work__link {
		text-decoration: none;
		display: block;
	}

	.featured-work__cover {
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.featured-work__cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease-out;
	}

	.featured-work__link:hover .featured-work__cover :global(img) {
		transform: scale(1.02);
	}

	.featured-work__body {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.featured-work__meta {
		font-size: 0.8125rem;
		color: var(--color-text-subtle);
	}

	.featured-work__title {
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.015em;
		color: var(--color-text);
	}

	.featured-work__summary {
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	@media (max-width: 768px) {
		.featured-work__grid {
			grid-template-columns: 1fr;
		}
		.featured-work__header {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
