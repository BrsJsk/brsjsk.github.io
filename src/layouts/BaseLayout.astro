---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import CookieConsent from '../components/consent/CookieConsent';
import { useTranslations } from '../i18n';
import { hasPublishedPosts } from '../lib/blog';
import { SITE_NAME, SITE_TAGLINE, GA_MEASUREMENT_ID } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const t = useTranslations();

// Feed autodiscovery is gated on the blog actually having posts, for the same
// reason the nav/footer links are — an advertised but empty feed is worse than
// no feed. See src/lib/blog.ts.
const showFeed = await hasPublishedPosts();

const isHome = Astro.url.pathname === '/';
const pageTitle = isHome ? `${SITE_NAME} — ${SITE_TAGLINE}` : `${title} — ${SITE_NAME}`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08090b" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		{
			showFeed && (
				<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — RSS`} href="/rss.xml" />
			)
		}

		<title>{pageTitle}</title>
		<Seo title={pageTitle} description={description} image={image} noindex={noindex} />

		<Font cssVariable="--font-display-src" preload />
		<Font cssVariable="--font-body-src" preload />

		<slot name="head" />
	</head>
	<body>
		<div class="grain" aria-hidden="true"></div>
		<a href="#main" class="skip-link">Skip to content</a>
		<Nav />
		<main id="main">
			<slot />
		</main>
		<Footer />
		{
			GA_MEASUREMENT_ID && (
				<CookieConsent
					client:idle
					gaId={GA_MEASUREMENT_ID}
					body={t.consent.body}
					accept={t.consent.accept}
					reject={t.consent.reject}
					privacyLabel={t.consent.privacy}
				/>
			)
		}
		<script>
			import { initMotion } from '../scripts/motion';
			initMotion();
		</script>
	</body>
</html>
