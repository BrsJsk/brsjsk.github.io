---
export const prerender = true;

import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';
import Button from '../../components/ui/Button.astro';
import ArrowIcon from '../../components/ui/ArrowIcon.astro';
import Reveal from '../../components/motion/Reveal.astro';
import VideoEmbed from '../../components/work/VideoEmbed.astro';
import ProjectGallery from '../../components/work/ProjectGallery.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const t = useTranslations();

const categoryLabel: Record<string, string> = {
	website: 'Website',
	'web-app': 'Web app',
	'mobile-app': 'Mobile app',
};

const testimonial = project.data.testimonial ? await getEntry(project.data.testimonial) : null;
const galleryImages = [project.data.cover, ...project.data.gallery];

// Only the fields this project actually has — the meta row collapses rather
// than showing empty "Client —" style gaps.
const metaFields: Array<{ label: string; value?: string }> = [
	{ label: t.work.client, value: project.data.client },
	{ label: t.work.year, value: project.data.year?.toString() },
	{ label: t.work.role, value: project.data.role.length ? project.data.role.join(', ') : undefined },
	{ label: t.work.stack, value: project.data.stack.length ? project.data.stack.join(', ') : undefined },
];
const shownMetaFields = metaFields.filter((f) => f.value);

const orderedProjects = (await getCollection('projects')).sort((a, b) => {
	if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
	return a.data.order - b.data.order;
});
const currentIndex = orderedProjects.findIndex((p) => p.id === project.id);
const nextProject = orderedProjects[(currentIndex + 1) % orderedProjects.length];
---

<BaseLayout title={project.data.title} description={project.data.summary}>
	<article class="case-study u-section">
		<div class="u-narrow">
			<Reveal class="case-study__header">
				<a href="/work" class="case-study__back">← {t.work.backToWork}</a>
				<p class="case-study__eyebrow">
					{[categoryLabel[project.data.category], project.data.year].filter(Boolean).join(' · ')}
				</p>
				<h1 class="case-study__title">{project.data.title}</h1>
				{project.data.summary && <p class="case-study__lead">{project.data.summary}</p>}
			</Reveal>
		</div>

		<div class="u-container">
			<Reveal as="div" class="case-study__meta">
				{
					shownMetaFields.map((field) => (
						<div>
							<p class="case-study__meta-label">{field.label}</p>
							<p class="case-study__meta-value">{field.value}</p>
						</div>
					))
				}
				{
					project.data.liveUrl && (
						<Button href={project.data.liveUrl} variant="secondary" size="sm" arrow class="case-study__visit">
							{t.work.visitSite}
						</Button>
					)
				}
			</Reveal>
		</div>

		<div class="u-container">
			<Reveal>
				<ProjectGallery images={galleryImages} alt={project.data.title} />
			</Reveal>
		</div>

		<div class="u-narrow">
			<Reveal as="div" class="prose">
				<Content />
			</Reveal>
		</div>

		{
			project.data.videoUrl && (
				<div class="u-narrow case-study__video">
					<Reveal>
						<VideoEmbed url={project.data.videoUrl} title={project.data.title} />
					</Reveal>
				</div>
			)
		}

		{
			project.data.metrics.length > 0 && (
				<div class="u-narrow">
					<Reveal stagger class="case-study__metrics">
						{project.data.metrics.map((metric) => (
							<div class="case-study__metric">
								<p class="case-study__metric-value">{metric.value}</p>
								<p class="case-study__metric-label">{metric.label}</p>
							</div>
						))}
					</Reveal>
				</div>
			)
		}

		{
			testimonial && (
				<div class="u-narrow">
					<Reveal class="case-study__testimonial">
						<blockquote>"{testimonial.data.quote}"</blockquote>
						<p class="case-study__testimonial-attribution">
							{testimonial.data.name} · {testimonial.data.role}, {testimonial.data.company}
						</p>
					</Reveal>
				</div>
			)
		}

		<div class="u-container">
			<Reveal as="a" href={`/work/${nextProject.id}`} class="case-study__next">
				<div>
					<p class="case-study__next-label">{t.work.nextProject}</p>
					<h3 class="case-study__next-title">{nextProject.data.title}</h3>
					<p class="case-study__next-summary">{nextProject.data.summary}</p>
				</div>
				<ArrowIcon class="case-study__next-arrow" />
			</Reveal>
		</div>
	</article>
</BaseLayout>

<style>
	.case-study {
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 6vw, 4.5rem);
	}

	.case-study__header {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.case-study__back {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.case-study__back:hover {
		color: var(--color-text);
	}

	.case-study__eyebrow {
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-subtle);
	}

	.case-study__title {
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--color-text);
	}

	.case-study__lead {
		max-width: 60ch;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	/* Flex rather than a fixed 4-column grid: projects carry different amounts
	   of metadata, and a fixed grid would leave holes for the sparser ones. */
	.case-study__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 3rem;
		align-items: end;
		padding-block: 1.5rem;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.case-study__meta-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-subtle);
		margin-bottom: 0.375rem;
	}

	.case-study__meta-value {
		font-size: 0.9375rem;
		color: var(--color-text);
	}

	.case-study__visit {
		justify-self: start;
	}

	.case-study__metrics {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
		gap: 1.5rem;
		padding-block: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.case-study__metric {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.case-study__metric-value {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 2rem;
		letter-spacing: -0.03em;
		color: var(--color-text);
	}

	.case-study__metric-label {
		font-size: 0.875rem;
		color: var(--color-text-subtle);
	}

	.case-study__testimonial {
		border-left: 2px solid var(--color-accent);
		padding-left: 1.5rem;
	}

	.case-study__testimonial blockquote {
		margin: 0;
		font-size: 1.1875rem;
		line-height: 1.5;
		color: var(--color-text);
	}

	.case-study__testimonial-attribution {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--color-text-subtle);
	}

	.case-study__next {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 2rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		text-decoration: none;
		transition:
			background-color 0.2s ease-out,
			border-color 0.2s ease-out;
	}

	.case-study__next:hover {
		background: var(--color-elevated);
		border-color: var(--color-border-strong);
	}

	.case-study__next-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-subtle);
		margin-bottom: 0.375rem;
	}

	.case-study__next-title {
		font-size: 1.5rem;
		font-weight: 500;
		color: var(--color-text);
	}

	.case-study__next-summary {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		margin-top: 0.25rem;
	}

	.case-study__next-arrow {
		flex-shrink: 0;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--color-text-muted);
	}

	@media (max-width: 768px) {
		.case-study__meta {
			grid-template-columns: repeat(2, 1fr);
		}
		.case-study__next {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
